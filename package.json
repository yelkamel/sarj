{
  "name": "sarj",
  "version": "0.1.0",
  "description": "Sarj (سرج) — a custom agent harness written from scratch. No agent framework, no SDK: one loop, tools, from-scratch RAG, a local LLM.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "chat": "tsx src/cli.ts",
    "eval": "tsx evals/run.ts",
    "build": "tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
